# Entorno: development | test | production
NODE_ENV=development
PORT=3000

# Adaptador de persistencia: memory | mongoose | prisma | sequelize
DB_DRIVER=memory
MONGO_URI=mongodb://localhost:27017/orders
DATABASE_URL=postgresql://app:app@localhost:5432/orders

# JWT (jsonwebtoken, HS256). Secreto de al menos 32 caracteres aleatorios
JWT_SECRET=change-me-with-at-least-32-random-characters
JWT_EXPIRES_IN_SECONDS=900
JWT_ISSUER=nest-hexagonal-adapters
JWT_AUDIENCE=nest-hexagonal-adapters-api

# Coste de scrypt (potencia de 2). OWASP recomienda 2^17
SCRYPT_COST=131072

# Admin sembrado al arrancar (opcional, ambos o ninguno)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# Contraseña común de los clientes de ejemplo de `pnpm db:seed` (mín. 8 caracteres)
SEED_PASSWORD=

# Orígenes CORS separados por comas
CORS_ORIGINS=http://localhost:5173

# Si se indica, el esquema GraphQL code-first se escribe en este fichero
GRAPHQL_SCHEMA_FILE=docs/schema.gql
